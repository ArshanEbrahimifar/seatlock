# Application
NODE_ENV=development
PORT=3000

# Main booking database
DATABASE_URL=postgresql://seatlock:seatlock@localhost:5432/seatlock?schema=public

# Ticket Service database
TICKETING_DATABASE_URL=postgresql://seatlock:seatlock@localhost:5432/seatlock_ticketing?schema=public

# Database connection pool
DB_POOL_MAX=20

# Seat / payment configuration
SEAT_HOLD_SECONDS=300
PAYMENT_WINDOW_SECONDS=600

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Transactional Outbox
OUTBOX_LOCK_SECONDS=30
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300