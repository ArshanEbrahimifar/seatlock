
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum EventSeatStatus {
  AVAILABLE
  HELD
  RESERVED
  BOOKED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats  Seat[]
  events Event[]
}

model Seat {
  id        String   @id @default(uuid()) @db.Uuid
  section   String
  row       String
  number    Int
  venueId   String   @db.Uuid
  createdAt DateTime @default(now())

  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventSeats EventSeat[]

  @@unique([venueId, section, row, number])
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startsAt  DateTime
  venueId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventSeats EventSeat[]
}

model EventSeat {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @db.Uuid
  seatId    String          @db.Uuid
  price     Decimal         @db.Decimal(10, 2)
  status    EventSeatStatus @default(AVAILABLE)

  holdToken     String?         @db.Uuid
  holdExpiresAt DateTime?


  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  seat  Seat  @relation(fields: [seatId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  order    Order[]

  @@unique([eventId, seatId])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  eventSeatId String      @db.Uuid
  amount      Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  eventSeat EventSeat @relation(fields: [eventSeatId], references: [id], onDelete: Restrict)

 @@index([eventSeatId, status])
}

enum OutboxEventType {
  ORDER_EXPIRATION
  ORDER_PAID
}

model OutboxEvent {
  id          String          @id @default(uuid()) @db.Uuid
  type        OutboxEventType
  payload     Json

  processedAt DateTime?
  deadLetteredAt DateTime?
  
  lockedAt    DateTime?
  lockedBy    String?
  
  attempts    Int             @default(0)
  nextAttemptAt  DateTime?
  lastError   String?

  createdAt   DateTime        @default(now())

  @@index([processedAt,deadLetteredAt,nextAttemptAt,lockedAt,createdAt])
}

model InboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@unique([consumer, eventId])
}

model Ticket {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @db.Uuid
  eventSeatId String   @unique @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  issuedAt    DateTime @default(now())
}